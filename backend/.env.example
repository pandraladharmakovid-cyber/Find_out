NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://findout:YOUR_LOCAL_PASSWORD@localhost:5432/findout
DATABASE_SSL=false

# Optional source credentials. Unconfigured sources are reported as unavailable.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=FindOut/1.0
YOUTUBE_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=
GEMINI_API_KEY=

REQUEST_TIMEOUT_MS=12000
MAX_REQUEST_BODY_BYTES=1048576
LOG_LEVEL=info
