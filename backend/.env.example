NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
# Optional: serve the built frontend from the API origin (single-process deploy
# or the demo server). Leave empty for the normal two-process dev setup.
SERVE_FRONTEND_DIR=

DATABASE_URL=postgresql://localhost:5432/findout
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# AI agent (Find_out Copilot) — OpenAI-compatible gateway
# ---------------------------------------------------------------------------
# Base URL must include /v1 (no trailing slash).
OPENAI_BASE_URL=https://api.aicredits.in/v1
# Paste your own key from the gateway dashboard. Never commit a real key.
OPENAI_API_KEY=
# The model you want the agent to use. If the gateway key is not allowed to
# use it, the agent automatically walks OPENAI_FALLBACK_MODELS and retries each
# model through /responses (some keys only serve OpenAI models there).
OPENAI_MODEL=anthropic/claude-sonnet-4.5
OPENAI_FALLBACK_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-4o-mini,openai/gpt-4.1-mini
# auto | chat | responses
OPENAI_TRANSPORT=auto
AI_AGENT_ENABLED=true
AI_AGENT_MAX_STEPS=6
AI_AGENT_TIMEOUT_MS=90000
AI_AGENT_MAX_OUTPUT_TOKENS=2400

# ---------------------------------------------------------------------------
# Optional source credentials. Unconfigured sources are reported as
# "not_configured" (never as a clean result).
# ---------------------------------------------------------------------------
# Gemini (independent of the AI agent). Retired model names return HTTP 404,
# so the model and its fallbacks are configurable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash-latest

# Bluesky public search (app password, not the account password)
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=paste-a-generated-app-password-here

YOUTUBE_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
# abuse.ch now requires an Auth-Key: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1

# App store monitoring
APPLE_STORE_COUNTRY=us
GOOGLE_PLAY_LANGUAGE=en
GOOGLE_PLAY_COUNTRY=US
APP_STORE_RESULT_LIMIT=25

# ---------------------------------------------------------------------------
# Complaint / takedown delivery. With no transport configured the API reports
# "not_configured" (HTTP 503) instead of pretending a notice was sent.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
COMPLAINT_FROM_EMAIL=
COMPLAINT_FROM_NAME=Find_out Brand Protection
# Alternative transport: POST the notice to a relay/webhook.
COMPLAINT_WEBHOOK_URL=
COMPLAINT_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Live cybersecurity alert feed (CISA KEV). Works without a key.
# ---------------------------------------------------------------------------
THREAT_FEED_ENABLED=true
THREAT_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
THREAT_FEED_CACHE_MS=900000

# ---------------------------------------------------------------------------
# Runtime limits
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT_MS=15000
MONITORING_SOURCE_TIMEOUT_MS=45000
MONITORING_RUN_DEADLINE_MS=110000
DB_STATEMENT_TIMEOUT_MS=15000
MAX_REQUEST_BODY_BYTES=1048576
LOG_LEVEL=info
